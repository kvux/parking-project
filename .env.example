# Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git — it's in .gitignore

# Flask configuration
FLASK_APP=app.py
FLASK_DEBUG=false

# JWT configuration (REQUIRED - generate a strong random string)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret-here

# Sensor API key (REQUIRED for /api/sensor/update endpoint)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(16))"
SENSOR_API_KEY=replace-with-a-strong-sensor-key-here

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=parking_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# CORS configuration
ALLOWED_ORIGIN=http://localhost:3000
